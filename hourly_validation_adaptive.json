  "task2_daily_deviation": {
    "method": "For each camera-day, deviation(h) = that source day's taxi share in the camera's area / typical taxi share for the source day's day type (typical = taxi-only pre-holdout profiles, 2023-01-01->2026-07-31). Nudge multiplier = 1 + alpha*(deviation-1), clipped to [0.5, 2.0], applied on top of the crash profile and renormalised per camera-day.",
    "source": "taxi-only (TNP ends 2026-09-30, so combined taxi+TNP would change composition mid-holdout; taxi covers the full holdout through 2026-11-01).",
    "availability_note": [
      "SAME-DAY is POST-HOC: the day's trips are not available at prediction time in production (taxi/TNP feeds lag ~2 weeks, like the violation feed). Prev-day and same-weekday-last-week are the forecastable versions (they use only trips from days before the prediction day)."
    ],
    "variants": {
      "profile_dev_sameday_a25": {
        "source_offset_days": 0,
